# Copy this file to .env and fill in your own values.
# Never put real keys or passwords in this file: it IS uploaded to GitHub.

# VirusTotal API key (VirusTotal profile -> API key)
VT_API_KEY=your_virustotal_key

# Only needed for the reporting inbox (inbox.py)
IMAP_HOST=imap.gmail.com
IMAP_USER=your.reporting.inbox@gmail.com